---
import AudioPlayer from './AudioPlayer.astro';

interface Props {
  episode: {
    title: string;
    description: string;
    pubDate: string;
    audioUrl: string;
    coverArt?: string;
    duration?: string;
  };
}

const { episode } = Astro.props;

const cleanText = (str: string) => {
  return str
    .replace(/<[^>]*>?/gm, '')
    .replace(/\s+/g, ' ')
    .trim();
};
---

<section id="latest" class="bg-[#121212] py-16 px-6 border-b border-neutral-800/60">
  <div class="max-w-5xl mx-auto grid md:grid-cols-12 gap-8 md:gap-12 items-center">
    
    <!-- Episode Artwork (Left Column) -->
    <div class="md:col-span-5 flex justify-center">
      <div class="relative w-full max-w-[340px] aspect-square rounded-2xl overflow-hidden shadow-2xl border border-neutral-800/80 group">
        {episode.coverArt ? (
          <img 
            src={episode.coverArt} 
            alt={episode.title} 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        ) : (
          <div class="w-full h-full bg-gradient-to-br from-neutral-800 to-neutral-900 flex items-center justify-center text-neutral-500">
            No Cover Art
          </div>
        )}
      </div>
    </div>

    <!-- Episode Details & Player (Right Column) -->
    <div class="md:col-span-7 space-y-5 text-left">
      
      <!-- Pill Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-neutral-800/90 border border-neutral-700/60 rounded-full text-xs font-medium text-neutral-300">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
        Latest Episode
      </div>

      <!-- Episode Title -->
      <h2 class="text-3xl md:text-4xl font-serif font-bold text-neutral-100 tracking-tight leading-tight">
        {episode.title}
      </h2>

      <!-- Metadata Line -->
      <div class="text-xs font-mono text-neutral-400 space-x-2">
        <span>{episode.pubDate}</span>
        {episode.duration && (
          <>
            <span>•</span>
            <span>{episode.duration}</span>
          </>
        )}
      </div>

      <!-- Description -->
      <p class="text-neutral-400 text-sm leading-relaxed line-clamp-3">
        {cleanText(episode.description)}
      </p>

      <!-- Custom Audio Player Block -->
      <div class="pt-2 max-w-lg">
        <AudioPlayer audioUrl={episode.audioUrl} id="latest-featured" />
      </div>

    </div>

  </div>
</section>