---
import AudioPlayer from './AudioPlayer.astro';

interface Episode {
  title: string;
  description: string;
  pubDate: string;
  audioUrl: string;
  coverArt?: string;
  duration?: string;
}

interface Props {
  episodes: Episode[];
}

const { episodes } = Astro.props;

// Take only the top 3 most recent episodes
const recentEpisodes = episodes.slice(0, 3);

const cleanText = (str: string) => {
  return str
    .replace(/<[^>]*>?/gm, '')
    .replace(/\s+/g, ' ')
    .trim();
};
---

<section id="all-episodes" class="bg-neutral-950 py-16 px-6 border-b border-neutral-900">
  <div class="max-w-5xl mx-auto">
    
    <!-- Section Header -->
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl md:text-3xl font-serif font-bold text-white tracking-tight">
        Recent Episodes
      </h2>
      <a 
        href="/episodes" 
        class="text-xs font-mono text-amber-500 hover:text-amber-400 transition-colors flex items-center gap-1 uppercase tracking-wider font-semibold"
      >
        View all archive <span class="text-sm">→</span>
      </a>
    </div>

    <!-- Scrollable Container for 3 Recent Episodes -->
    <div class="relative pl-6 md:pl-10 space-y-6 max-h-[520px] overflow-y-auto pr-2 custom-scrollbar">
      
      <!-- Vertical Timeline Line -->
      <div class="absolute left-3 md:left-5 top-4 bottom-4 w-[1px] bg-neutral-800"></div>

      {recentEpisodes.map((ep, index) => {
        const episodeNum = episodes.length - index;
        const playerId = `timeline-ep-${index}`;

        return (
          <div class="relative group">
            <!-- Timeline Number Circle -->
            <div class="absolute -left-[30px] md:-left-[42px] top-6 w-7 h-7 rounded-full bg-neutral-900 border border-amber-500/40 text-amber-400 font-mono text-xs font-bold flex items-center justify-center z-10 group-hover:border-amber-400 group-hover:scale-110 transition-all">
              {episodeNum}
            </div>

            <!-- Card Content -->
            <div class="bg-neutral-900/70 border border-neutral-800/80 rounded-xl p-5 md:p-6 hover:border-neutral-700/80 transition-all shadow-md">
              <div class="grid md:grid-cols-12 gap-6 items-center">
                
                <!-- Thumbnail Cover -->
                <div class="md:col-span-3 flex-shrink-0">
                  {ep.coverArt ? (
                    <img 
                      src={ep.coverArt} 
                      alt={ep.title} 
                      class="w-full aspect-square object-cover rounded-lg border border-neutral-800 shadow"
                    />
                  ) : (
                    <div class="w-full aspect-square bg-neutral-800 rounded-lg flex items-center justify-center text-xs text-neutral-500">
                      No Art
                    </div>
                  )}
                </div>

                <!-- Episode Details -->
                <div class="md:col-span-9 space-y-3">
                  <div class="flex items-center gap-2 text-xs font-mono text-neutral-400">
                    <span class="text-amber-500 uppercase tracking-widest font-semibold">
                      Episode #{episodeNum}
                    </span>
                    <span>•</span>
                    <span>{ep.pubDate}</span>
                    {ep.duration && (
                      <>
                        <span>•</span>
                        <span>{ep.duration}</span>
                      </>
                    )}
                  </div>

                  <h3 class="text-xl font-bold text-white group-hover:text-amber-400 transition-colors leading-snug">
                    {ep.title}
                  </h3>

                  <p class="text-neutral-400 text-xs md:text-sm line-clamp-2 leading-relaxed">
                    {cleanText(ep.description)}
                  </p>

                  <!-- Audio Player Row -->
                  <div class="pt-2">
                    <AudioPlayer audioUrl={ep.audioUrl} id={playerId} />
                  </div>
                </div>

              </div>
            </div>

          </div>
        );
      })}

      <!-- Simple Text Link at the end of scroll -->
      <div class="pt-6 pb-2 text-center">
        <a 
          href="/episodes" 
          class="inline-flex items-center gap-2 text-sm font-semibold text-neutral-400 hover:text-amber-400 transition-colors group"
        >
          View Full Before and After the Movies Catalogue
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

    </div>

  </div>
</section>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: #0a0a0a;
    border-radius: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #262626;
    border-radius: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #f59e0b;
  }
</style>