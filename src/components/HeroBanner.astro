---

<header class="relative overflow-hidden bg-neutral-950 text-neutral-100 min-h-[85vh] flex flex-col justify-between border-b border-neutral-900">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-amber-950/30 via-neutral-950/90 to-neutral-950 pointer-events-none"></div>

  <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden">
    <span class="text-[18vw] font-black tracking-tighter uppercase text-transparent bg-clip-text bg-gradient-to-b from-white/10 to-transparent leading-none whitespace-nowrap translate-x-12">
      BEFORE & AFTER
    </span>
  </div>

  <div class="relative max-w-6xl w-full mx-auto px-6 pt-20 pb-20 my-auto z-10">
    <div class="max-w-xl space-y-8">
      
      <div class="space-y-1">
        <p class="text-xs font-mono tracking-widest text-amber-400/80 uppercase font-semibold">
          {tagline}
        </p>
        <div class="w-12 h-[1px] bg-amber-500/30"></div>
      </div>

      <h1 class="text-6xl md:text-8xl font-serif font-medium tracking-tight text-amber-50/95 leading-[0.9]">
        Before & <br />
        <span class="italic font-normal">After</span> The Movies
      </h1>

      <p class="text-neutral-400 text-base md:text-lg leading-relaxed font-sans max-w-md">
        {description}
      </p>

      <div class="flex items-center gap-6 pt-2">
        <a 
          href="#latest" 
          class="px-6 py-3.5 bg-[#D35F48] hover:bg-[#be523d] text-white text-sm font-semibold rounded-lg transition-colors shadow-lg flex items-center gap-2"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
          Play latest
        </a>

        <a 
          href="#all-episodes" 
          class="text-sm font-semibold text-neutral-300 hover:text-white transition-colors flex items-center gap-1 group"
        >
          All episodes 
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <!-- Listen On Section -->
      <div class="pt-6 border-t border-neutral-900/80 space-y-3">
        <span class="text-[11px] font-mono tracking-[0.2em] text-neutral-400 uppercase font-bold block">
          Listen On
        </span>

        <div class="flex flex-wrap items-center gap-2.5">
          {platforms.map((p) => (
            <a
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              title={`Listen on ${p.name}`}
              class="w-12 h-12 bg-neutral-900/90 border border-neutral-800 hover:border-neutral-700 rounded-xl flex items-center justify-center transition-all duration-300 hover:scale-105 hover:bg-neutral-800/80 group"
            >
              <div class={`w-7 h-7 rounded-lg ${p.iconBg} flex items-center justify-center text-white shadow-sm`}>
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" set:html={p.icon}></svg>
              </div>
            </a>
          ))}
        </div>
      </div>

    </div>
  </div>
</header>